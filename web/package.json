{
  "name": "personal-website-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test node --import tsx --test $(find src -type f -name '*.test.ts')",
    "test:watch": "NODE_ENV=test node --import tsx --test --watch $(find src -type f -name '*.test.ts')",
    "test:e2e": "playwright test",
    "validate:links": "tsx scripts/validate-internal-links.ts",
    "check:bundle-budget": "tsx scripts/check-bundle-budget.ts",
    "launch:readiness": "tsx scripts/launch-readiness.ts",
    "lighthouse:ci": "lhci autorun --config=lighthouserc.json",
    "security:rate-limit-smoke": "tsx scripts/rate-limit-smoke.ts",
    "revalidate:content": "tsx scripts/revalidate-content.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/lib/db/seed.ts",
    "db:seed:dev": "ALLOW_SEED=true tsx src/lib/db/seed.ts",
    "db:apply-community-impact": "tsx scripts/apply-community-impact-portfolio.ts",
    "db:apply-research": "tsx scripts/apply-research-content.ts",
    "db:apply-achievements": "tsx scripts/apply-achievements-portfolio.ts",
    "db:apply-media": "tsx scripts/apply-media-portfolio.ts",
    "db:apply-writing": "tsx scripts/apply-writing-portfolio.ts",
    "db:apply-testimonials": "tsx scripts/apply-testimonials-portfolio.ts",
    "db:apply-org-metrics": "tsx scripts/apply-org-metrics-portfolio.ts",
    "db:apply-about": "tsx scripts/apply-about-content.ts"
  },
  "dependencies": {
    "@auth/core": "0.41.2",
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@hookform/resolvers": "^5.2.2",
    "@marsidev/react-turnstile": "^1.5.1",
    "@sentry/nextjs": "^10.51.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.44.6",
    "framer-motion": "^12.38.0",
    "isomorphic-dompurify": "^3.12.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "next-auth": "5.0.0-beta.31",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.74.0",
    "resend": "^6.12.2",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
